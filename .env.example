# --- apps/web ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8787

# --- apps/api ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SCAN8004_API_KEY=
SCAN8004_BASE_URL=https://8004scan.io/api

# Chain RPCs
BSC_MAINNET_RPC=https://bsc-dataseed.binance.org
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545

# Altana
ALTANA_API_KEY=
ALTANA_ENV=testnet   # testnet | mainnet

# Agent Studio (per-agent, set once each agent is deployed)
AGENT_STUDIO_REBALANCING_ID=
AGENT_STUDIO_GRID_ID=
AGENT_STUDIO_YIELD_ID=
AGENT_STUDIO_HEALTH_ID=

# Yield Optimisation — reference asset used for the marketplace's public
# "best APR available" stat (not tied to any user's position)
AAVE_V3_DATA_PROVIDER_ADDRESS=
YIELD_REFERENCE_AAVE_ASSET=       # e.g. USDT on BSC
YIELD_REFERENCE_VENUS_VTOKEN=     # e.g. vUSDT on BSC

# Health Factor Monitoring
AAVE_V3_POOL_ADDRESS=
HEALTH_FACTOR_REPAY_STEP=

# Session contract allowlists — comma-separated addresses, pulled from the
# relevant skill file at skills.altana.network, not hardcoded from memory
ALTANA_ALLOWLIST_PANCAKESWAP_LIQUIDITY=
ALTANA_ALLOWLIST_PANCAKESWAP_TRADING=
ALTANA_ALLOWLIST_YIELD_VENUES=
ALTANA_ALLOWLIST_LENDING_DEFENSE=

# CORS — apps/api's Hono server only
WEB_ORIGIN=http://localhost:3000

# --- apps/api/src/a2a-server.ts (packages/a2a-server) ---
A2A_PUBLIC_URL=http://localhost:8788/a2a
A2A_PORT=8788
AGENT_STUDIO_MARKETPLACE_ERC8004_ID=       # cross-referenced in the Agent Card's extensions, set once deployed

# x402 payment gate — off (pass-through) until the real
# @altananetwork/x402-server Express integration is verified; see
# packages/a2a-server/src/lib/x402Guard.ts before setting this true
A2A_REQUIRE_PAYMENT=false
A2A_PAYTO_ADDRESS=
A2A_PRICE_PER_TASK=0.10
A2A_PAYMENT_TOKEN=USDT

# Health Factor Monitoring — the asset the agent repays in
HEALTH_FACTOR_DEBT_ASSET=

# Agent session signers — TESTNET-ONLY key handling, see
# packages/a2a-server/src/lib/agentSigner.ts before using anywhere real
AGENT_SIGNER_KEY_HEALTH_FACTOR=
AGENT_SIGNER_KEY_REBALANCING=
AGENT_SIGNER_KEY_GRID_TRADING=
AGENT_SIGNER_KEY_YIELD_OPTIMISATION=
